{
  "name": "codegraph",
  "displayName": "codegraph",
  "description": "A live semantic knowledge graph of your codebase, beside your editor.",
  "version": "0.0.1",
  "private": true,
  "publisher": "codegraph",
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "codegraph.open",
        "title": "codegraph: Open Graph Panel (active file)"
      },
      {
        "command": "codegraph.openWorkspace",
        "title": "codegraph: Open Workspace Graph"
      },
      {
        "command": "codegraph.refresh",
        "title": "codegraph: Refresh & Diff (show what changed)"
      },
      {
        "command": "codegraph.diffBaseline",
        "title": "codegraph: Diff Against Git Ref (HEAD, branch, tag)"
      },
      {
        "command": "codegraph.copyMcpConfig",
        "title": "codegraph: Copy MCP Config (connect your AI agent)"
      },
      {
        "command": "codegraph.exportGraph",
        "title": "codegraph: Export Graph Snapshot (portable JSON)"
      }
    ],
    "configuration": {
      "title": "codegraph",
      "properties": {
        "codegraph.languages.typescript": {
          "type": "boolean",
          "default": true,
          "description": "Include TypeScript / JavaScript files in the graph."
        },
        "codegraph.languages.python": {
          "type": "boolean",
          "default": true,
          "description": "Include Python files in the graph (accurate edges via Pyright, no Python runtime needed)."
        },
        "codegraph.exclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra directory names to skip when scanning the workspace (in addition to node_modules, .git, dist, .venv, etc.)."
        },
        "codegraph.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "codegraph collects no telemetry. This setting is off and reserved."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "mcp": "node dist/mcp-server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:boundaries": "depcruise \"src/**/*.ts\" --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run lint:boundaries && npm run test && npm run build",
    "bench": "tsx bench/benchmark.ts",
    "spike:pyright": "tsx bench/pyright-spike.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "pyright": "^1.1.411",
    "sigma": "^3.0.3",
    "ts-morph": "^28.0.0",
    "vscode-jsonrpc": "^8.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.105.0",
    "dependency-cruiser": "^16.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
