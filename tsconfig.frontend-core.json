{
  // Emit the framework-agnostic pure core (+ the pure webview builders) as
  // real ESM .js + .d.ts that the Next.js frontend consumes. The core uses
  // NodeNext `.js` specifiers on .ts sources; Turbopack will NOT remap `.js`→`.ts`
  // (unlike esbuild/tsc), so we compile once to a tree of real `.js` files where
  // those specifiers resolve. Output keys the frontend's @core/@adapters aliases.
  // Regenerated automatically by the frontend's prebuild/predev script.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": false,
    "outDir": "frontend/vendor/core",
    "rootDir": "src",
    "types": []
  },
  "include": [
    "src/core/**/*.ts",
    "src/adapters/surfaces/webview/render-model.ts",
    "src/adapters/surfaces/webview/card.ts",
    "src/adapters/surfaces/webview/lod.ts",
    "src/adapters/surfaces/webview/layout3d.ts",
    "src/adapters/surfaces/webview/folder-layout.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "src/core/watch/**"]
}
